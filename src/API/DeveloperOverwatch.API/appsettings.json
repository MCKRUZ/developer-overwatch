{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Database": {
    "Provider": "sqlite",
    "ConnectionString": "Data Source=/data/overwatch.db",
    "UseManagedIdentityAuth": false,
    "ManagedIdentityClientId": ""
  },
  "ApiKeys": {
    "Keys": []
  },
  "Authentication": {
    "Authority": "",
    "Audience": "",
    "RequireHttpsMetadata": true
  },
  "Cors": {
    "Origins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "Governance": {
    "UseManagedIdentityAuth": true,
    "LlmApiUrl": "",
    "LlmModel": "claude-sonnet-5-gce"
  },
  "GitHub": {
    "BaseUrl": "https://api.github.com",
    "Token": "",
    "WebhookSecret": ""
  },
  "CostAlerts": {
    "DailyThresholdUsd": 50.00
  },
  "SessionActivity": {
    "StaleAfterMinutes": 30
  },
  "TokenPricing": {
    "Models": {
      "default": {
        "InputPerMillionUsd": 3.00,
        "OutputPerMillionUsd": 15.00,
        "CacheWritePerMillionUsd": 3.75,
        "CacheReadPerMillionUsd": 0.30
      },
      "claude-opus": {
        "InputPerMillionUsd": 15.00,
        "OutputPerMillionUsd": 75.00,
        "CacheWritePerMillionUsd": 18.75,
        "CacheReadPerMillionUsd": 1.50
      },
      "claude-sonnet": {
        "InputPerMillionUsd": 3.00,
        "OutputPerMillionUsd": 15.00,
        "CacheWritePerMillionUsd": 3.75,
        "CacheReadPerMillionUsd": 0.30
      },
      "claude-haiku": {
        "InputPerMillionUsd": 1.00,
        "OutputPerMillionUsd": 5.00,
        "CacheWritePerMillionUsd": 1.25,
        "CacheReadPerMillionUsd": 0.10
      }
    }
  },
  "RateLimiting": {
    "Default": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    },
    "Webhook": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "Notifications": {
    "Slack": {
      "Enabled": false,
      "WebhookUrl": "",
      "MinimumSeverity": "Error"
    },
    "Email": {
      "Enabled": false,
      "SmtpHost": "",
      "SmtpPort": 587,
      "UseSsl": true,
      "FromAddress": "",
      "ToAddresses": [],
      "MinimumSeverity": "Critical"
    }
  }
}
