{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Database": {
    "Provider": "sqlite",
    "ConnectionString": "Data Source=/data/overwatch.db"
  },
  "ApiKeys": {
    "Keys": []
  },
  "Authentication": {
    "Authority": "",
    "Audience": "",
    "RequireHttpsMetadata": true
  },
  "Cors": {
    "Origins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "GitHub": {
    "BaseUrl": "https://api.github.com",
    "Token": "",
    "WebhookSecret": ""
  },
  "RateLimiting": {
    "Default": {
      "PermitLimit": 100,
      "WindowSeconds": 60
    },
    "Webhook": {
      "PermitLimit": 30,
      "WindowSeconds": 60
    }
  },
  "Notifications": {
    "Slack": {
      "Enabled": false,
      "WebhookUrl": "",
      "MinimumSeverity": "Error"
    },
    "Email": {
      "Enabled": false,
      "SmtpHost": "",
      "SmtpPort": 587,
      "UseSsl": true,
      "FromAddress": "",
      "ToAddresses": [],
      "MinimumSeverity": "Critical"
    }
  }
}
