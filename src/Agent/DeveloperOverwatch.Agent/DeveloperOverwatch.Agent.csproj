<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DeveloperOverwatch.Agent</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>overwatch-agent</ToolCommandName>
    <PackageId>DeveloperOverwatch.Agent</PackageId>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.*" />
    <!-- Override transitive SQLitePCLRaw 2.1.11 (GHSA-2m69-gcr7-jv3q, high severity) with the patched 3.0.x line. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pure Domain: no package dependencies, so it adds one small DLL to the tool. -->
    <ProjectReference Include="..\..\Domain\DeveloperOverwatch.Domain\DeveloperOverwatch.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Resources\default-prices.json" />
    <EmbeddedResource Include="Resources\default-prices.json" LogicalName="DeveloperOverwatch.Agent.default-prices.json" />
  </ItemGroup>
</Project>
